# ============================================================
# GiveWize — environment variable reference (.env.example)
# Copy to .env and fill in real values from 1Password.
# .env is gitignored — NEVER commit real values.
# ============================================================

# --- Frontend (Vite) — PUBLIC, safe to expose to the browser ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local marketing script (social_media_generator.py) ---
ANTHROPIC_API_KEY=          # 1Password: "Anthropic — GiveWize Social"
OPENAI_API_KEY=             # 1Password: "OpenAI — GiveWize image"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=     # 1Password: "LinkedIn — GiveWize client secret"
LINKEDIN_ACCESS_TOKEN=      # regenerate via OAuth (expires ~60 days)
LINKEDIN_PERSON_ID=
LINKEDIN_ORG_ID=
META_ACCESS_TOKEN=          # 1Password: "Meta — GiveWize Instagram"
INSTAGRAM_ACCOUNT_ID=

# ============================================================
# SERVER-SIDE — these are NOT read from this file.
# Set them in Supabase → GiveWize → Edge Functions → Secrets.
# Listed here only so you know they exist.
#   ANTHROPIC_API_KEY          (1Password: "Anthropic — GiveWize Edge")
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  (admin key — never put in frontend/.env)
#   RESEND_API_KEY             (follow-up emails)
#   SITE_URL
# ============================================================
